// Crash Bandicoot resident recompiler seeds.
//
// psxport's emitter independently roots discovery at the PS-X EXE entry point, scans binary
// pointers/tables, and follows direct calls. These lists are therefore deliberately empty. Add an
// address only after a real run reports an indirect-only `[recomp-MISS]`, with the observation that
// proves it belongs here. Never copy another title's addresses or guess overlay load bases: either
// can make a successful emission decode the wrong function boundaries.
{
  "main": [],
  // Binary-backed host-frame split points. Each is a genuine mid-function continuation, not a new
  // guest function: the native driver enters one finite CoreLoop iteration, returns at its retail
  // back-edge, and replaces only the two VSync waits while retaining every generated super.
  "main_reentry": [
    "0x80012030",
    "0x80012510",
    "0x800170F4",
    "0x800170FC",
    "0x80017124",
    "0x8001712C"
  ],
